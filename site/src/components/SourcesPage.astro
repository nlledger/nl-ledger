---
import { isBrokenPublisherLink } from "../../lib/page-format.mjs";
import Schedule from "./Schedule.astro";
import { datasetLabel } from "../common.mjs";
import PageHead from "./PageHead.astro";
import { num, moneyWords, date as fmtDate } from "../../lib/format.mjs";
import { REPO } from "../../lib/html.mjs";
const { SOURCES, DATASETS, counts, LICENCES, SOURCE_LICENCE, OTHER, card, D } =
  Astro.props;
---

<PageHead
  crumbs={[
    ["/", "Home"],
    [null, "Sources"],
  ]}
  title={"Sources and report card"}
  lede={
    "Where every figure comes from, what each source covers, and how well each publisher does at publishing it."
  }
/>
<section class="section">
  <div class="wrap">
    <h2 style="margin-block-end:1.5rem">Line-item sources</h2>
    {SOURCES.filter((s) => DATASETS.includes(s.ds)).map((s) => {
      const c = counts[s.ds] || {};
      return (
        <>
          <article
            id={s.ds}
            style="padding-block:1.25rem;border-block-end:1px solid var(--hair)"
          >
            <h3>{datasetLabel(s.ds)}</h3>
            <p class="small muted" style="margin:.3rem 0 .6rem">
              {s.publisher} ·{" "}
              <a href={s.url}>
                {s.url.replace(/^https?:\/\//, "").slice(0, 60)}
              </a>
            </p>
            <p>{s.what}</p>
            <p class="small">{s.form}</p>
            <p class="small">
              Licence:{" "}
              <a href={LICENCES[SOURCE_LICENCE[s.ds]].url}>
                {LICENCES[SOURCE_LICENCE[s.ds]].name}
              </a>
              .
            </p>
            <p class="small">
              <strong>
                {num(c.n || 0)} records (CAD values only; native currency and
                missing amounts are shown on each record)
                {c.a ? `, ${moneyWords(c.a)}` : ""}
              </strong>
              {c.d0 ? `, dated ${fmtDate(c.d0)} to ${fmtDate(c.d1)}` : ""}.{" "}
              <a href={"/search/?ds=" + s.ds}>Search them</a>.
            </p>
          </article>
        </>
      );
    })}
    <h2 style="margin-block:2.5rem 1rem">Other sources</h2>
    <>
      <Schedule label="Sources and coverage">
        <thead>
          <tr>
            <th scope="col">Source</th>
            <th scope="col">Used for</th>
          </tr>
        </thead>
        <tbody>
          {OTHER.map(([t, u, w]) => (
            <tr>
              <th scope="row">
                <>
                  <a href={u}>{t}</a>
                </>
              </th>
              <td>{w}</td>
            </tr>
          ))}
        </tbody>
      </Schedule>
    </>
  </div>
</section>
<section class="section" id="licences">
  <div class="wrap">
    <div class="section-head">
      <h2>Licences</h2>
      <p>
        Each source stays under the terms of the body that published it. The
        site's own code is under the{" "}
        <a href={REPO + "/blob/main/LICENSE"}>MIT licence</a>.
      </p>
    </div>
    <>
      <Schedule label="Publisher licences" compact>
        <thead>
          <tr>
            <th scope="col">Source</th>
            <th scope="col">Publisher</th>
            <th scope="col">Licence</th>
            <th scope="col">Attribution and conditions</th>
          </tr>
        </thead>
        <tbody>
          {[
            ...SOURCES.filter((s) => DATASETS.includes(s.ds)).map((s) => [
              datasetLabel(s.ds),
              s.publisher,
              LICENCES[SOURCE_LICENCE[s.ds]],
            ]),
            ...OTHER.map(([t, , , k]) => [t, "", LICENCES[k]]),
          ].map(([src, pub, l]) => (
            <tr>
              <th scope="row">{src}</th>
              <td>{pub}</td>
              <td>
                <>
                  <a href={l.url}>{l.name}</a>
                </>
              </td>
              <td>{l.wording ? `Required wording: "${l.wording}"` : l.note}</td>
            </tr>
          ))}
        </tbody>
      </Schedule>
    </>
    <p class="small">
      Statistics Canada tables: the required wording is completed with the
      table's number and reference date, as listed under Other sources. Every
      record links to the original. Reuse of House of Assembly records follows
      those publishers' terms, not the federal licence.
    </p>
  </div>
</section>
<section class="section" id="report-card">
  <div class="wrap">
    <div class="section-head">
      <h2>Publisher report card</h2>
      <p>
        How complete, correct and usable each publisher's records are. This
        grades the publishing, not the spending.
      </p>
    </div>
    {card.map((c) => (
      <>
        <div style="padding-block:1rem;border-block-end:1px solid var(--hair)">
          <h3>{c.body}</h3>
          <ul class="prose" style="margin-block:.5rem 0">
            {c.grade.map((g) => (
              <>
                <li>{g}</li>
              </>
            ))}
          </ul>
        </div>
      </>
    ))}
    <h3 style="margin-block:2rem .8rem">Award printings counted once</h3>
    <p class="small">
      The full contract and purchase-order numbers and award details must agree,
      or a source review must explain the repeat. Equal amounts and nearby dates
      alone do not remove an award. Each counted record keeps its other
      printings and receipts.
    </p>
    <>
      <Schedule label="Award printings counted once" compact>
        <thead>
          <tr>
            <th scope="col">Other printing</th>
            <th scope="col">Why it is counted once</th>
          </tr>
        </thead>
        <tbody>
          {D.issues
            .filter(
              (i) =>
                i.source === "PPA contract awards" &&
                /counted once with/.test(i.issue),
            )
            .map((i) => (
              <tr>
                <th scope="row">
                  <>
                    <a href={i.url}>{i.url.split("/").pop()}</a>
                  </>
                </th>
                <td>{i.issue}</td>
              </tr>
            ))}
        </tbody>
      </Schedule>
    </>
    <h3 style="margin-block:2rem .8rem">Broken links found</h3>
    <>
      <Schedule label="Broken source links" compact>
        <thead>
          <tr>
            <th scope="col">Source</th>
            <th scope="col">Link</th>
            <th scope="col">Problem</th>
          </tr>
        </thead>
        <tbody>
          {D.issues
            .filter((i) => isBrokenPublisherLink(i.issue))
            .map((i) => (
              <tr>
                <th scope="row">{i.source}</th>
                <td>
                  <>
                    <a href={i.url}>{i.url.split("/").pop()}</a>
                  </>
                </td>
                <td>{i.issue}</td>
              </tr>
            ))}
        </tbody>
      </Schedule>
    </>
    <h3 style="margin-block:2rem .8rem">Publisher total discrepancies</h3>
    <>
      <Schedule label="Publisher total discrepancies" compact>
        <thead>
          <tr>
            <th scope="col">Source</th>
            <th scope="col">Receipt</th>
            <th scope="col">Discrepancy</th>
          </tr>
        </thead>
        <tbody>
          {D.issues
            .filter((i) => /publisher discrepancy/.test(i.issue))
            .map((i) => (
              <tr>
                <th scope="row">{i.source}</th>
                <td>
                  <>
                    <a href={i.url}>{i.url.split("/").pop()}</a>
                  </>
                </td>
                <td>{i.issue}</td>
              </tr>
            ))}
        </tbody>
      </Schedule>
    </>
  </div>
</section>
