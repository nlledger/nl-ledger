---
import { march } from "../../lib/budget-format.mjs";
import BudgetLedgerItem from "./BudgetLedgerItem.astro";
import { moneyWords, money } from "../../lib/format.mjs";
import { icon } from "../../lib/icons.mjs";
import Citation from "./Citation.astro";
const {
  y,
  c,
  citeBudget,
  citeSpent,
  deficit,
  a,
  citeBal,
  citeDebt,
  pp,
  citePP,
} = Astro.props;
---

<div class="cover-ledger">
  <dl aria-label={"Departments' spending against the budget, " + y.year}>
    <BudgetLedgerItem
      label={"Budgeted"}
      figure={
        <>
          {moneyWords(c.gross.budget)}
          <Citation citation={citeBudget} />
        </>
      }
      note={"in the spring Estimates"}
    />
    <BudgetLedgerItem
      label={"Spent"}
      figure={
        <>
          {moneyWords(c.gross.actual)}
          <Citation citation={citeSpent} />
        </>
      }
      note={"by departments"}
    />
    <BudgetLedgerItem
      label={c.difference < 0 ? "Under budget" : "Over budget"}
      figure={moneyWords(Math.abs(c.difference))}
      note={`${(Math.abs(c.share) * 100).toFixed(1)}% ${c.difference < 0 ? "less" : "more"} than budgeted`}
    />
  </dl>
  <dl aria-label={"How the year ended for the whole government, " + y.year}>
    <BudgetLedgerItem
      label={deficit ? "Deficit" : "Surplus"}
      figure={
        <>
          {moneyWords(Math.abs(a.balance.actual))}
          <Citation citation={citeBal} />
        </>
      }
      note={`budget forecast: ${moneyWords(Math.abs(a.balance.budget))}${a.balance.budget < 0 === deficit ? "" : a.balance.budget < 0 ? " deficit" : " surplus"}`}
    />
    <BudgetLedgerItem
      label={"Net debt"}
      figure={
        <>
          {moneyWords(a.net_debt.actual)}
          <Citation citation={citeDebt} />
        </>
      }
      note={
        pp ? (
          <>
            {money(pp.value)} a person
            <Citation citation={citePP} />
          </>
        ) : (
          `at ${march(y.year)}`
        )
      }
    />
  </dl>
  <p class="cover-ledger-more">
    <a href="/budget/">
      Budget against actual, department by department{" "}
      <Fragment set:html={icon("arrow")} />
    </a>
  </p>
</div>
