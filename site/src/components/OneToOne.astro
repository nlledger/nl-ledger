---
const { money, amount, href, title, body, against } = Astro.props;
---

<aside class="one">
  <p class="one-tag" aria-hidden="true">
    1:1
  </p>
  <p class="one-amt">
    <Fragment set:html={money(amount)} />
  </p>
  <p class="one-title">
    {href ? (
      <>
        <a href={href}>{title}</a>
      </>
    ) : (
      title
    )}
  </p>
  {body ? (
    <>
      <p class="one-body">
        {typeof body === "string" ? <Fragment set:html={body} /> : body}
      </p>
    </>
  ) : (
    ""
  )}
  {against
    ? (() => {
        const r = amount / against.amount;
        const txt =
          r >= 1
            ? `${r >= 10 ? Math.round(r) : r.toFixed(1)} times ${against.label}`
            : `${(r * 100).toFixed(r < 0.1 ? 1 : 0)}% of ${against.label}`;
        return (
          <>
            <p class="one-meter">
              <span class="track">
                <span
                  style={
                    "inline-size:" +
                    Math.min(100, Math.max(0.3, r * 100)).toFixed(2) +
                    "%"
                  }
                ></span>
              </span>
              <span>
                <Fragment set:html={txt} />
              </span>
            </p>
          </>
        );
      })()
    : ""}
</aside>
