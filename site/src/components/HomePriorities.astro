---
import Bar from "./Bar.astro";
import { moneyWords, money, perPerson } from "../../lib/format.mjs";
import { icon } from "../../lib/icons.mjs";
const { fy, top, max, S, depts, total, D } = Astro.props;
---

<section class="section" aria-labelledby="pr-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="pr-h">Priorities</h2>
      <p class="lede">
        Where the provincial dollar went in {fy}, set against what the budget
        said it would cost.
      </p>
    </div>
    <ul class="legend">
      <li>
        <span class="sw"></span>Spent (actual)
      </li>
      <li>
        <span class="sw ghost"></span>Budgeted (original estimate)
      </li>
    </ul>
    <p class="sched-hint">Scroll sideways for more columns.</p>
    <div class="sched-wrap">
      <table
        aria-label="Provincial spending by department"
        class="sched pin-rows"
      >
        <thead>
          <tr>
            <th scope="col">Department</th>
            <th scope="col" class="hide-sm" style="inline-size:36%">
              Spent against budget
            </th>
            <th scope="col" class="n">
              Spent
            </th>
            <th scope="col" class="n">
              Budgeted
            </th>
            <th scope="col" class="n hide-sm">
              Per person
            </th>
          </tr>
        </thead>
        <tbody>
          {top.map((d) => (
            <>
              <tr>
                <th scope="row">
                  <a href={"/department/" + d.slug + "/"}>{d.name}</a>
                </th>
                <td class="hide-sm">
                  <span class="pair">
                    <Bar value={d.gross} max={max} />
                    {d.original != null ? (
                      <Bar value={d.original} max={max} cls={"ghost"} />
                    ) : (
                      ""
                    )}
                  </span>
                </td>
                <td class="n">{moneyWords(d.gross)}</td>
                <td class="n">
                  {d.original ? moneyWords(d.original) : "not printed"}
                </td>
                <td class="n hide-sm">{money(perPerson(d.gross, S))}</td>
              </tr>
            </>
          ))}
          <tr class="sub">
            <th scope="row">
              <a href="/priorities/">
                {depts.length - top.length} more departments
              </a>
            </th>
            <td class="hide-sm"></td>
            <td class="n">
              {moneyWords(
                depts.slice(top.length).reduce((s, d) => s + d.gross, 0),
              )}
            </td>
            <td class="n">
              {moneyWords(
                depts
                  .slice(top.length)
                  .reduce((s, d) => s + (d.original || 0), 0),
              )}
            </td>
            <td class="n hide-sm">
              {money(
                perPerson(
                  depts.slice(top.length).reduce((s, d) => s + d.gross, 0),
                  S,
                ),
              )}
            </td>
          </tr>
        </tbody>
        <tfoot>
          <tr class="total">
            <th scope="row">All {depts.length} departments</th>
            <td class="hide-sm"></td>
            <td class="n">{moneyWords(total)}</td>
            <td class="n">
              {moneyWords(depts.reduce((s, d) => s + (d.original || 0), 0))}
            </td>
            <td class="n hide-sm">{money(perPerson(total, S))}</td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p style="margin-block-start:1.5rem">
      <a href="/priorities/">
        Every department and program, {D.years[0]} to {fy}{" "}
        <Fragment set:html={icon("arrow")} />
      </a>{" "}
      · <a href="/budget/">Budget against actual, the deficit and net debt</a>
    </p>
  </div>
</section>
