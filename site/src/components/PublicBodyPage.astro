---
import Schedule from "./Schedule.astro";
import { ITEM_COLS, datasetLabel } from "../common.mjs";
import Caveat from "./Caveat.astro";
import PageHead from "./PageHead.astro";
import { num, moneyWords, date as fmtDate } from "../../lib/format.mjs";
import Bar from "./Bar.astro";
import ItemRow from "./ItemRow.astro";
import { icon } from "../../lib/icons.mjs";
import { FEDERAL_RULE } from "../../lib/federal.mjs";
import FederalSummary from "./FederalSummary.astro";
const {
  b,
  sets,
  dept,
  D,
  byDs,
  flagNotes,
  subjectFlags,
  methods,
  mmax,
  byYear,
  ymax,
  suppliers,
  smax,
  top,
  itemRow,
  recent,
} = Astro.props;
---

<PageHead
  flagged={true}
  crumbs={[
    ["/", "Home"],
    ["/bodies/", "Public bodies"],
    [null, b.buyer],
  ]}
  title={b.buyer}
  lede={
    <>
      {num(b.n)} records, {moneyWords(b.amount)} in CAD published record values
      across all years, from{" "}
      {sets
        .map(datasetLabel)
        .map((label) => label.toLowerCase())
        .join(", ")}
      .
      {sets.length > 1 &&
        " Sources can overlap; this sum is not a deduplicated spending total."}{" "}
      Values are not total money paid.
      {dept && (
        <>
          {" "}
          <a href={`/department/${D.slug(dept.name)}/`}>
            Program spending for {dept.name}
          </a>
          .
        </>
      )}
    </>
  }
/>
<section class="section">
  <div class="wrap grid-2">
    <div>
      <h2 style="margin-block-end:1rem">What is on record</h2>
      {b.level === "federal" ? (
        <Caveat
          text={`${FEDERAL_RULE} CAD totals cover only supported CAD amounts. These are selected records, not all the department’s activity. Notices and disclosures can overlap; combined record values are not spending totals.`}
        />
      ) : (
        ""
      )}
      {sets.includes("ppa") ? (
        <Caveat
          text={
            "These are published contract award reports, not a complete ledger of this body's purchases or payments. This page shows the body as buyer; money it receives as a supplier or grant recipient belongs in a separate search."
          }
        />
      ) : (
        ""
      )}
      <dl class="leaders">
        {byDs.map((d) => (
          <div>
            <dt>
              <span>
                {datasetLabel(d.dataset)}{" "}
                <span class="muted small">
                  {num(d.n)}, {fmtDate(d.d0)} to {fmtDate(d.d1)}
                </span>
              </span>
            </dt>
            <dd>{moneyWords(d.amount)}</dd>
          </div>
        ))}
      </dl>
      {flagNotes.length ? (
        <>
          <h3 style="margin-block:2rem .6rem">Patterns</h3>
          <ul class="prose">
            {flagNotes.map((t, i) => (
              <>
                <li>
                  {t}{" "}
                  <a href={"/flags/" + subjectFlags[i].flag + "/"}>
                    How this is worked out
                  </a>
                </li>
              </>
            ))}
          </ul>
          <Caveat
            text={
              "A flag is a question, not a finding. It is not evidence that anything wrong happened."
            }
          />
        </>
      ) : (
        ""
      )}
    </div>
    <div>
      {methods.length > 1 ? (
        <>
          <h3 style="margin-block-end:.8rem">Reported procurement methods</h3>
          <p class="small">
            CAD record values, all years; sources can overlap. Federal addresses
            do not locate work or benefits.
          </p>
          <>
            <Schedule label="Reported procurement methods" compact>
              <thead>
                <tr>
                  <th scope="col">Method</th>
                  <th data-graphic-header scope="col" style={"inline-size:" + "40%"}>
                    <span class="vh">Relative amount</span>
                  </th>
                  <th scope="col" class="n">
                    Awards
                  </th>
                  <th scope="col" class="n">
                    Value
                  </th>
                </tr>
              </thead>
              <tbody>
                {methods.map((m) => (
                  <tr>
                    <th scope="row">{m.m}</th>
                    <td>
                      <Bar value={m.amount || 0} max={mmax} />
                    </td>
                    <td class="n">{num(m.n)}</td>
                    <td class="n">{moneyWords(m.amount || 0)}</td>
                  </tr>
                ))}
              </tbody>
            </Schedule>
          </>
        </>
      ) : (
        ""
      )}
      {byYear.length > 1 ? (
        <>
          <h3 style="margin-block:1.5rem .8rem">By original record date</h3>
          <p class="small">
            CAD reported values, not annual payments. Sources can overlap;
            federal addresses do not locate work or benefits.
          </p>
          <>
            <Schedule label="Public body records by date" compact>
              <thead>
                <tr>
                  <th scope="col">Year</th>
                  <th data-graphic-header scope="col" style={"inline-size:" + "50%"}>
                    <span class="vh">Relative amount</span>
                  </th>
                  <th scope="col" class="n">
                    Value
                  </th>
                </tr>
              </thead>
              <tbody>
                {byYear.map((y) => (
                  <tr>
                    <th scope="row">{y.y}</th>
                    <td>
                      <Bar value={y.amount || 0} max={ymax} />
                    </td>
                    <td class="n">{moneyWords(y.amount || 0)}</td>
                  </tr>
                ))}
              </tbody>
            </Schedule>
          </>
        </>
      ) : (
        ""
      )}
    </div>
  </div>
</section>
{b.level === "federal" ? (
  <>
    <section class="section">
      <div class="wrap">
        <FederalSummary
          D={D}
          where={
            "buyer_key=? AND dataset IN ('fed_contract','fed_grant','canadabuys')"
          }
          args={[b.buyer_key]}
        />
      </div>
    </section>
  </>
) : (
  ""
)}
<section class="section">
  <div class="wrap">
    <h2 style="margin-block-end:1rem">Largest reported values by supplier</h2>
    <p class="small">
      CAD record values, all years; sources can overlap. Federal addresses do
      not locate work or benefits.
    </p>
    <>
      <Schedule label="Public body suppliers">
        <thead>
          <tr>
            <th scope="col">Supplier</th>
            <th data-graphic-header scope="col" style={"inline-size:" + "34%"}>
              <span class="vh">Relative amount</span>
            </th>
            <th scope="col" class="n">
              Records
            </th>
            <th scope="col" class="n">
              Value
            </th>
          </tr>
        </thead>
        <tbody>
          {suppliers.map((s) => (
            <tr>
              <th scope="row">
                <>
                  <a href={"/supplier/" + D.keyHash(s.supplier_key) + "/"}>
                    {s.supplier}
                  </a>
                </>
              </th>
              <td>
                <Bar value={s.amount || 0} max={smax} />
              </td>
              <td class="n">{num(s.n)}</td>
              <td class="n">{moneyWords(s.amount || 0)}</td>
            </tr>
          ))}
        </tbody>
      </Schedule>
    </>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <h2 style="margin-block-end:1rem">Largest records</h2>
    <>
      <Schedule label="Largest public body records">
        <thead>
          <tr>
            {ITEM_COLS.map((c) => (
              <th
                scope="col"
                class={c.num ? "n" : undefined}
                style={c.w ? `inline-size:${c.w}` : undefined}
              >
                {c.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {top.map((a) => (
            <ItemRow
              D={D}
              it={a}
              {...{
                showBuyer: false,
              }}
            />
          ))}
        </tbody>
      </Schedule>
    </>
    <h2 style="margin-block:2.5rem 1rem">Most recent</h2>
    <>
      <Schedule label="Public body records">
        <thead>
          <tr>
            {ITEM_COLS.map((c) => (
              <th
                scope="col"
                class={c.num ? "n" : undefined}
                style={c.w ? `inline-size:${c.w}` : undefined}
              >
                {c.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {recent.map((a) => (
            <ItemRow
              D={D}
              it={a}
              {...{
                showBuyer: false,
              }}
            />
          ))}
        </tbody>
      </Schedule>
    </>
    <p style="margin-block-start:1.5rem">
      <a href={"/search/?b=" + D.keyHash(b.buyer_key)}>
        Search all {num(b.n)} records for {b.buyer}{" "}
        <Fragment set:html={icon("arrow")} />
      </a>
    </p>
  </div>
</section>
