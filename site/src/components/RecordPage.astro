---
import { amountText } from "../../lib/page-format.mjs";
import Standing from "./Standing.astro";
import {
  money,
  perPerson,
  workTime,
  date as fmtDate,
  DATASET_LABEL,
  AMOUNT_LABEL,
} from "../../lib/format.mjs";
import RecordParty from "./RecordParty.astro";
import BodyLink from "./BodyLink.astro";
import { icon } from "../../lib/icons.mjs";
import ReceiptLink from "./ReceiptLink.astro";
import FlagItem from "./FlagItem.astro";
import SpotError from "./SpotError.astro";
import {
  isFederal,
  amountBasis,
  federalStatement,
  moneyLimit,
  REVIEW_LABEL,
  nativeAmount,
} from "../../lib/federal.mjs";
const { title, it, stats, href, pdf, x, fl, links } = Astro.props;
---

<header class="pagehead">
  <div class="wrap">
    <p class="crumbs">
      <a href="/">Home</a> / <a href="/search/">Search</a> / Record
    </p>
    <h1>{title}</h1>
    {it.d && (it.s || it.p) ? (
      <>
        <p class="lede">{it.d}</p>
      </>
    ) : (
      ""
    )}
    <Standing />
  </div>
</header>
<section class="section">
  <div class="wrap grid-2">
    <div>
      <p class="cover-fig record-amount">{amountText(it)}</p>
      <p class="small muted amount-note">
        {isFederal(it)
          ? amountBasis(it)
          : AMOUNT_LABEL[it.ds] || "Published value"}
        .
        {["ppa", "fed_contract", "canadabuys"].includes(it.ds)
          ? " This is a contract or award value, not the amount paid out."
          : it.ds === "fed_grant"
            ? " An agreement can cover several years; this is not the amount paid out."
            : it.ds === "sunshine"
              ? " From the over-$100,000 list, rounded to $100 by the publisher."
              : ""}
      </p>
      {isFederal(it) ? (
        <>
          <p class="lede">{federalStatement(it)}</p>
          <p class="small">{moneyLimit(it)}</p>
        </>
      ) : it.a ? (
        <>
          <p class="lede">
            {money(perPerson(it.a, stats), {
              cents: true,
            })}{" "}
            per person in the province. {workTime(it.a, stats)} of work at the
            median full-time wage.
          </p>
        </>
      ) : (
        ""
      )}
      <dl class="leaders facts">
        {[
          it.s
            ? {
                label:
                  it.ds === "mha"
                    ? "Paid to"
                    : it.ds === "fed_grant" || it.ds === "pa_tp"
                      ? "Recipient"
                      : "Supplier",
                value: <RecordParty it={it} />,
              }
            : null,
          x.supplier_as_printed
            ? { label: "Name as printed", value: x.supplier_as_printed }
            : null,
          it.p
            ? {
                label:
                  it.ds === "sunshine"
                    ? "Name as published"
                    : it.ds === "mha"
                      ? "Member"
                      : "Minister",
                value: it.p,
              }
            : null,
          it.b
            ? {
                label: it.ds === "sunshine" ? "Employer" : "Public body",
                value: (
                  <BodyLink
                    name={it.b}
                    links={links}
                    sunshine={it.ds === "sunshine"}
                  />
                ),
              }
            : null,
          {
            label:
              it.ds === "fed_grant"
                ? "Agreement start"
                : it.ds === "canadabuys"
                  ? "Award date"
                  : it.ds === "sunshine"
                    ? "Year"
                    : "Date",
            value:
              it.ds === "sunshine"
                ? String(it.t || "").slice(0, 4)
                : fmtDate(it.t) || it.fy || "not printed",
          },
          it.m
            ? {
                label:
                  it.ds === "mha"
                    ? "Allowance"
                    : it.ds === "fed_grant"
                      ? "Program"
                      : "Method",
                value: it.m,
              }
            : null,
          x.clause ? { label: "Clause cited", value: x.clause } : null,
          x.reason ? { label: "Reason given", value: x.reason } : null,
          x.limited_reason
            ? { label: "Limited tendering reason", value: x.limited_reason }
            : null,
          x.original_value
            ? { label: "Original value", value: money(x.original_value) }
            : null,
          x.contract_no
            ? { label: "Contract number", value: x.contract_no }
            : null,
          x.term ? { label: "Term", value: x.term } : null,
          x.district ? { label: "District", value: x.district } : null,
          x.routes ? { label: "Flights", value: x.routes } : null,
          x.unit ? { label: "Unit", value: x.unit } : null,
          x.base != null
            ? { label: "Base salary", value: money(x.base) }
            : null,
          x.overtime ? { label: "Overtime", value: money(x.overtime) } : null,
          x.bonus ? { label: "Bonuses", value: money(x.bonus) } : null,
          x.shift ? { label: "Shift premium", value: money(x.shift) } : null,
          x.retro
            ? { label: "Retroactive salary", value: money(x.retro) }
            : null,
          x.severance
            ? { label: "Severance", value: money(x.severance) }
            : null,
          x.other && it.ds === "sunshine"
            ? { label: "Other compensation", value: money(x.other) }
            : null,
          x.invoice ? { label: "Invoice", value: x.invoice } : null,
          x.report_period
            ? {
                label: "Reported in",
                value: `the report for ${x.report_period.replace(" to ", " to ")}`,
              }
            : null,
          x.weeks ? { label: "Voucher weeks", value: x.weeks } : null,
          x.amount_text
            ? { label: "Price as printed", value: x.amount_text }
            : null,
          { label: "Record type", value: DATASET_LABEL[it.ds] || it.ds },
        ]
          .filter(Boolean)
          .map((x) => (
            <div class={x.cls}>
              <dt>
                <span>{x.label}</span>
              </dt>
              <dd>{x.value}</dd>
            </div>
          ))}
      </dl>
    </div>
    <div>
      <div class="receipt">
        <h3>Receipt</h3>
        <p>{it.l || ""}</p>
        <p>
          <a class="btn solo" href={href} rel="noopener">
            <span>Open the source {pdf && it.g ? `at page ${it.g}` : ""}</span>{" "}
            <Fragment set:html={icon("out")} />
          </a>
        </p>
        {x.machine_read ? (
          <>
            <p class="small">
              Machine-read from a scanned image; compare with the page before
              quoting.
            </p>
          </>
        ) : (
          ""
        )}
        {x.note ? (
          <>
            <p class="small">{x.note}</p>
          </>
        ) : (
          ""
        )}
        {isFederal(it) ? (
          <>
            <h3>Source location evidence</h3>
            <p class="small">
              {REVIEW_LABEL[x.scope_review_state || "unreviewed"]}.
            </p>
            <p class="small">
              Reported address:{" "}
              {Object.entries(x.reported_location || {})
                .filter(([, v]) => v)
                .map(([k, v]) => `${k.replaceAll("_", " ")}: ${v}`)
                .join("; ") || "not stated"}
              .{" "}
              {x.location_conflict
                ? `Conflicting fields: ${x.location_conflict}.`
                : ""}
            </p>
            <p class="small">
              How counted: {x.how_counted || "as published"}.{" "}
              {typeof x.amount_period === "string"
                ? `Financial period: ${x.amount_period}.`
                : `Start: ${x.amount_period?.start || "not stated"}; end: ${x.amount_period?.end || "not stated"}; reported: ${x.amount_period?.reported || "not stated"}.`}{" "}
              Amount: {x.amount_coverage || "not stated"}.
            </p>
            <ul class="prose small">
              {(x.scope_evidence || []).map((e) => (
                <>
                  <li>
                    {e.field || "Evidence"}: {e.value}{" "}
                    <ReceiptLink
                      url={e.source_url}
                      page={null}
                      locator={e.locator}
                    />
                  </li>
                </>
              ))}
            </ul>
            <details>
              <summary>Full source fields</summary>
              <dl>
                {Object.entries(x.source_fields || {}).map(([k, v]) => (
                  <>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </>
                ))}
              </dl>
            </details>
            {x.amendment_chain_review ? (
              <>
                <p class="small">
                  {x.amendment_chain_review.reason}{" "}
                  <a href={x.amendment_chain_review.source_url}>
                    Official amendment history
                  </a>
                  , reviewed {x.amendment_chain_review.reviewed}.
                </p>
              </>
            ) : (
              ""
            )}
            {x.amendment_history?.length ? (
              <>
                <details>
                  <summary>Amendment history, counted once</summary>
                  <ul class="prose small">
                    {x.amendment_history.map((r) => (
                      <>
                        <li>
                          {r.supplier}: {nativeAmount(r.amount, "CAD")};
                          original {nativeAmount(r.original_value, "CAD")};
                          start {r.start}; procurement {r.procurement_id}.{" "}
                          <ReceiptLink
                            url={r.source_url}
                            page={null}
                            locator={`CSV line ${r.csv_line}`}
                          />
                        </li>
                      </>
                    ))}
                  </ul>
                </details>
              </>
            ) : (
              ""
            )}
          </>
        ) : (
          ""
        )}
        {x.repeat_printings?.length ? (
          <>
            <h3>Other printings, counted once</h3>
            <ul class="prose small">
              {x.repeat_printings.map((r) => (
                <>
                  <li>
                    <a href={r.source_url + "#page=" + r.page} rel="noopener">
                      {r.source_file.split("/").pop()}, {r.locator}
                    </a>
                    :{r.supplier}; {r.buyer || "buyer not printed"};{" "}
                    {r.description}; contract {r.contract_no};{" "}
                    {fmtDate(r.award_date) || "date not printed"};
                    {money(r.amount, {
                      cents: true,
                    })}
                    ; {r.term || "term not printed"}; renewal:{" "}
                    {r.renewal || "not printed"}.{r.note}
                  </li>
                </>
              ))}
            </ul>
          </>
        ) : (
          ""
        )}
      </div>
      {fl.length ? (
        <>
          <h3 style="margin-block:2rem .6rem">Patterns</h3>
          <ul class="flaglist">
            {fl.map((f) => (
              <FlagItem f={f} method={true} />
            ))}
          </ul>
        </>
      ) : (
        ""
      )}
    </div>
  </div>
</section>
<div class="wrap">
  <SpotError />
</div>
