---
import { march } from "../../lib/budget-format.mjs";
import BudgetCashRow from "./StatementRow.astro";
import BudgetCell from "./BudgetCell.astro";
import Citation from "./Citation.astro";
import BudgetReceipt from "./BudgetReceipt.astro";
import { money } from "../../lib/format.mjs";
const { a, fy, citeDebtBudget, DOCS, pp, citePP } = Astro.props;
---

<p class="sched-hint">Scroll sideways for more columns.</p>
<div class="sched-wrap">
  <table class="sched pin-rows stmt tight">
    <caption>How the year ended for the whole government</caption>
    <thead>
      <tr>
        <th scope="col">
          <span class="vh">Line</span>
        </th>
        <th scope="col" class="n">
          Budget
        </th>
        <th scope="col" class="n">
          Actual
        </th>
        <th scope="col" class="n">
          Difference
        </th>
      </tr>
    </thead>
    <tbody>
      <BudgetCashRow label={"Revenue"} x={a.revenue} />
      <BudgetCashRow label={"Expense"} x={a.expense} />
      <tr class="total">
        <th scope="row">Surplus or (deficit)</th>
        <BudgetCell value={a.balance.budget} />
        <BudgetCell value={a.balance.actual} />
        <BudgetCell value={a.balance.actual - a.balance.budget} />
      </tr>
      <BudgetCashRow
        label={
          <>
            Net debt at {march(fy)}
            <Citation citation={citeDebtBudget} />
            <span class="meta">what is owed, less financial assets held</span>
          </>
        }
        x={a.net_debt}
      />
    </tbody>
  </table>
</div>
<p class="small muted">
  Accrual basis, audited: departments together with Crown corporations, boards
  and authorities. {DOCS.public_accounts},{" "}
  <BudgetReceipt source={a.balance.source} /> and{" "}
  <BudgetReceipt source={a.net_debt.source} />. The budget column is the
  Original Budget the statements print, unaudited.
  {pp ? (
    <>
      {" "}
      Net debt for each person in the province, as the province works it out:{" "}
      <strong>{money(pp.value)}</strong>
      <Citation citation={citePP} />.
    </>
  ) : (
    ""
  )}
</p>
