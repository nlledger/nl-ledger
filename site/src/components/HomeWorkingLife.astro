---
import SpendingCallout from "./SpendingCallout.astro";
import {
  money,
  moneyWords,
  perPerson,
  perHousehold,
  workTime,
} from "../../lib/format.mjs";
import Citation from "./Citation.astro";
import ReceiptLink from "./ReceiptLink.astro";
import { icon } from "../../lib/icons.mjs";
const { median, career, fy, h, m, total, S, citeHH, perHour, ex } = Astro.props;
---

<section class="section" aria-labelledby="life-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="life-h">What a working life buys</h2>
      <p class="lede">
        Someone earning the median full-time wage here, {money(median)} a year,
        makes about {moneyWords(career)} over a 40-year career. In {fy} the
        province spent that much every {h} hours and {m} minutes.
      </p>
    </div>
    <div style="max-inline-size:40rem;margin-block-end:2.5rem">
      <dl class="leaders big">
        <div>
          <dt>
            <span>{`Provincial spending for every resident, ${fy.replace("-", "\u2011")}`}</span>
          </dt>
          <dd>{money(perPerson(total, S))}</dd>
        </div>
        <div>
          <dt>
            <span>
              <>
                Provincial spending for every household
                <Citation citation={citeHH} />
              </>
            </span>
          </dt>
          <dd>{money(perHousehold(total, S))}</dd>
        </div>
        <div>
          <dt>
            <span>
              Provincial spending every hour, around the clock, all year
            </span>
          </dt>
          <dd>{moneyWords(perHour, 1)}</dd>
        </div>
        <div class={"total"}>
          <dt>
            <span>A 40-year career at the median wage</span>
          </dt>
          <dd>{moneyWords(career)}</dd>
        </div>
      </dl>
    </div>
    <div class="grid-2" style="align-items:stretch">
      {ex.map((e) => (
        <SpendingCallout
          {...{
            title: e.title,
            amount: e.amount,
            href: e.href,
            body: (
              <>
                {e.what} It would take someone on the median wage{" "}
                <strong>{workTime(e.amount, S)}</strong> to earn.{" "}
                <ReceiptLink url={e.url} page={e.page} locator={e.locator} />
              </>
            ),
            against: {
              amount: career,
              label: "a 40-year career at the median wage",
            },
          }}
        />
      ))}
    </div>
    <p style="margin-block-start:2rem">
      <a class="btn solo" href="/scale/">
        Compare with $1 billion <Fragment set:html={icon("arrow")} />
      </a>
    </p>
  </div>
</section>
