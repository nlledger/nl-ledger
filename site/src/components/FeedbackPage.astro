---
import FeedbackHead from "./FeedbackHead.astro";
const { title, lede, feedbackForm, form } = Astro.props;
---

<FeedbackHead title={title} lede={lede} />
<section class="fb fb-page" id="feedback" aria-label="Feedback">
  <div class="fb-in">
    <Fragment set:html={await feedbackForm(form)} />
  </div>
</section>
