---
import Schedule from "./Schedule.astro";
import { nameOrder } from "../../lib/page-format.mjs";
import PageHead from "./PageHead.astro";
import { num, money, date as fmtDate } from "../../lib/format.mjs";
import ReceiptLink from "./ReceiptLink.astro";
import { icon } from "../../lib/icons.mjs";
import SpotError from "./SpotError.astro";
const { m, yrs, byYearCat, vendors, D, big, phash } = Astro.props;
---

<PageHead
  flagged={true}
  crumbs={[
    ["/", "Home"],
    ["/members/", "Members"],
    [null, nameOrder(m.person)],
  ]}
  title={nameOrder(m.person)}
  lede={`Member of the House of Assembly for ${m.district || "a district"}. ${num(m.n)} expense lines from ${m.y0} to ${m.y1}, ${money(m.amount)} in all.`}
/>
<section class="section">
  <div class="wrap">
    {yrs
      .map((y) => {
        const cats = [...byYearCat.values()]
          .filter((e) => e.y === y)
          .sort((a, b) => b.a - a.a);
        return (
          <>
            <Schedule compact>
              <caption>{y}</caption>
              <thead>
                <tr>
                  <th scope="col">Allowance category</th>
                  <th scope="col" class="n">
                    Lines
                  </th>
                  <th scope="col" class="n">
                    Spent
                  </th>
                  <th scope="col" class="n">
                    Source
                  </th>
                </tr>
              </thead>
              <tbody>
                {cats.map((c) => (
                  <tr>
                    <th scope="row">{c.cat}</th>
                    <td class="n">{num(c.n)}</td>
                    <td class="n">
                      {money(c.a, {
                        cents: true,
                      })}
                    </td>
                    <td class="n">
                      <ReceiptLink url={c.url} page={c.page} />
                    </td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr class="total">
                  <th scope="row">Total</th>
                  <td class="n">{num(cats.reduce((s, c) => s + c.n, 0))}</td>
                  <td class="n">
                    {money(
                      cats.reduce((s, c) => s + c.a, 0),
                      {
                        cents: true,
                      },
                    )}
                  </td>
                  <td class="n">{""}</td>
                </tr>
              </tfoot>
            </Schedule>
          </>
        );
      })
      .flatMap((node, index) =>
        index ? [<div style="block-size:2rem"></div>, node] : [node],
      )}
  </div>
</section>
<section class="section">
  <div class="wrap grid-2">
    <div>
      <h2 style="margin-block-end:1rem">Paid to</h2>
      <>
        <Schedule compact>
          <thead>
            <tr>
              <th scope="col">Vendor as printed</th>
              <th scope="col" class="n">
                Lines
              </th>
              <th scope="col" class="n">
                Paid
              </th>
            </tr>
          </thead>
          <tbody>
            {vendors.map((v) => (
              <tr>
                <th scope="row">
                  <>
                    <a href={"/supplier/" + D.keyHash(v.supplier_key) + "/"}>
                      {v.supplier}
                    </a>
                  </>
                </th>
                <td class="n">{num(v.n)}</td>
                <td class="n">{money(v.a)}</td>
              </tr>
            ))}
          </tbody>
        </Schedule>
      </>
    </div>
    <div>
      <h2 style="margin-block-end:1rem">Largest lines</h2>
      <>
        <Schedule compact>
          <thead>
            <tr>
              <th scope="col">Line</th>
              <th scope="col" class="n">
                Amount
              </th>
              <th scope="col" class="n">
                Source
              </th>
            </tr>
          </thead>
          <tbody>
            {big.map((l) => (
              <tr>
                <th scope="row">
                  <>
                    {l.supplier || ""}
                    <span class="meta">
                      {l.description || ""} · {l.method} · {fmtDate(l.date)}
                    </span>
                  </>
                </th>
                <td class="n">
                  {money(l.amount, {
                    cents: true,
                  })}
                </td>
                <td class="n">
                  <ReceiptLink
                    url={l.source_url}
                    page={l.page}
                    locator={l.locator}
                  />
                </td>
              </tr>
            ))}
          </tbody>
        </Schedule>
      </>
      <p>
        <a href={"/search/?ds=mha&p=" + phash}>
          Search all {num(m.n)} lines <Fragment set:html={icon("arrow")} />
        </a>
      </p>
    </div>
  </div>
</section>
<div class="wrap">
  <SpotError />
</div>
