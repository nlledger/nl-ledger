---
import Schedule from "./Schedule.astro";
import Caveat from "./Caveat.astro";
import PageHead from "./PageHead.astro";
import { moneyWords, money, num } from "../../lib/format.mjs";
import Citation from "./Citation.astro";
import Bar from "./Bar.astro";
import ReceiptLink from "./ReceiptLink.astro";
const { latest, cite, byYear, vmax, byDept, D, byProg, fed } = Astro.props;
---

<PageHead
  crumbs={[
    ["/", "Home"],
    [null, "Consultants and professional services"],
  ]}
  title={"Government consultants and professional services spending"}
  lede={
    <>
      The province's own accounts put spending on outside expertise, such as
      consultants, in one line called Professional Services. In {latest.y} it
      came to {moneyWords(latest.v)}
      <Citation citation={cite} />.
    </>
  }
/>
<section class="section">
  <div class="wrap">
    <Caveat
      text={
        <>
          "Professional Services" is broader than consulting. In health it is
          mostly doctors paid fee-for-service under the Medical Care Plan, and
          it includes legal, engineering and other outside services, so read the
          program name before reading the figure. This account gives totals by
          program, not individual contracts; contract awards that mention
          consulting are in the <a href="/search/?q=consulting">search</a>.
        </>
      }
    />
    <div class="grid-2">
      <div>
        <h2 style="margin-block-end:1rem">By year</h2>
        <>
          <Schedule label="Professional services by year" compact>
            <thead>
              <tr>
                <th scope="col">Fiscal year</th>
                <th data-graphic-header scope="col" style={"inline-size:" + "50%"}>
                  <span class="vh">Relative amount</span>
                </th>
                <th scope="col" class="n">
                  Professional services
                </th>
              </tr>
            </thead>
            <tbody>
              {byYear.map((r) => (
                <tr>
                  <th scope="row">{r.y}</th>
                  <td>
                    <Bar value={r.v} max={vmax} />
                  </td>
                  <td class="n">{moneyWords(r.v)}</td>
                </tr>
              ))}
            </tbody>
          </Schedule>
        </>
      </div>
      <div>
        <h2 style="margin-block-end:1rem">By department, {latest.y}</h2>
        <>
          <Schedule label="Professional services by department" compact>
            <thead>
              <tr>
                <th scope="col">Department</th>
                <th scope="col" class="n">
                  Professional services
                </th>
                <th scope="col" class="n">
                  Source
                </th>
              </tr>
            </thead>
            <tbody>
              {byDept.map((d) => (
                <tr>
                  <th scope="row">
                    <>
                      <a
                        href={
                          "/department/" + D.slug(D.pretty(d.department)) + "/"
                        }
                      >
                        {D.pretty(d.department)}
                      </a>
                    </>
                  </th>
                  <td class="n">{moneyWords(d.v)}</td>
                  <td class="n">
                    <ReceiptLink url={d.source_url} page={d.page} />
                  </td>
                </tr>
              ))}
            </tbody>
          </Schedule>
        </>
      </div>
    </div>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <h2 style="margin-block-end:1rem">Largest programs, {latest.y}</h2>
    <>
      <Schedule label="Professional services by program">
        <thead>
          <tr>
            <th scope="col">Program</th>
            <th scope="col">Department</th>
            <th scope="col" class="n">
              Professional services
            </th>
            <th scope="col" class="n">
              Source
            </th>
          </tr>
        </thead>
        <tbody>
          {byProg.map((p) => (
            <tr>
              <th scope="row">{p.program}</th>
              <td>{D.pretty(p.department)}</td>
              <td class="n">{money(p.v)}</td>
              <td class="n">
                <ReceiptLink url={p.source_url} page={p.page} />
              </td>
            </tr>
          ))}
        </tbody>
      </Schedule>
    </>
  </div>
</section>
{fed.length ? (
  <>
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>Federal payments for professional and special services</h2>
          <p>
            Published annual payments over $100,000 selected by the payee’s
            reported NL location, from the Public Accounts of Canada. An address
            does not establish where work, benefits or spending occurred. This
            series is separate from provincial professional-services actuals and
            may overlap federal commitments.
          </p>
        </div>
        <>
          <Schedule
            label="Federal professional services payments by year"
            compact
          >
            <thead>
              <tr>
                <th scope="col">Fiscal year</th>
                <th scope="col" class="n">
                  Payments
                </th>
                <th scope="col" class="n">
                  Paid
                </th>
              </tr>
            </thead>
            <tbody>
              {fed.map((r) => (
                <tr>
                  <th scope="row">{r.y}</th>
                  <td class="n">{num(r.n)}</td>
                  <td class="n">{moneyWords(r.v)}</td>
                </tr>
              ))}
            </tbody>
          </Schedule>
        </>
        <p>
          <a href="/search/?ds=pa_pss">Search these federal payments</a> ·{" "}
          <a href="/search/?q=consulting">Search every record for consulting</a>
        </p>
      </div>
    </section>
  </>
) : (
  ""
)}
