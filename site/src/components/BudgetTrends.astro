---
import { share, words } from "../../lib/budget-format.mjs";
import BudgetYearLink from "./BudgetYearLink.astro";
import BudgetSources from "./BudgetSources.astro";
import Bar from "./Bar.astro";
import BudgetCell from "./BudgetCell.astro";
import BudgetReceipt from "./BudgetReceipt.astro";
import BudgetUnit from "./BudgetUnit.astro";
import { money } from "../../lib/format.mjs";
const { B, maxYear, accord, restated } = Astro.props;
---

<section class="section" id="years">
  <div class="wrap">
    <div class="section-head">
      <h2>Year by year</h2>
      <p>
        Each year as its own documents printed it. The two newest budgets have
        no published results yet.
      </p>
    </div>
    <ul class="legend">
      <li>
        <span class="sw"></span>Spent
      </li>
      <li>
        <span class="sw ghost"></span>Budgeted
      </li>
    </ul>
    <p class="sched-hint">Scroll sideways for more columns.</p>
    <div class="sched-wrap">
      <table class="sched pin-rows tight">
        <caption>Spending by departments</caption>
        <thead>
          <tr>
            <th scope="col">Fiscal year</th>
            <th scope="col" class="hide-sm" style="inline-size:30%">
              Spent against budget
            </th>
            <th scope="col" class="n">
              Budgeted
            </th>
            <th scope="col" class="n">
              Spent
            </th>
            <th scope="col" class="n">
              Over (under)
            </th>
            <th scope="col" class="n hide-sm">
              %
            </th>
            <th scope="col" class="n hide-sm">
              Source
            </th>
          </tr>
        </thead>
        <tbody>
          {B.years
            .filter((x) => x.cash.gross.budget != null)
            .map((x) => (
              <>
                <tr>
                  <th scope="row">
                    <BudgetYearLink x={x} latestYear={B.latest.year} />
                    <BudgetSources
                      pairs={[
                        [x.cash.budget_source, "Budget source"],
                        [x.cash.actual_source, "Actual source"],
                      ]}
                    />
                  </th>
                  <td class="hide-sm">
                    <span class="pair">
                      {x.cash.gross.actual != null ? (
                        <Bar value={x.cash.gross.actual} max={maxYear} />
                      ) : (
                        <>
                          <span class="bar"></span>
                        </>
                      )}
                      <Bar
                        value={x.cash.gross.budget}
                        max={maxYear}
                        cls={"ghost"}
                      />
                    </span>
                  </td>
                  <BudgetCell value={x.cash.gross.budget} />
                  <BudgetCell value={x.cash.gross.actual} />
                  {x.cash.difference == null ? (
                    <>
                      <td class="n"></td>
                    </>
                  ) : (
                    <BudgetCell value={x.cash.difference} />
                  )}
                  <td class={"n hide-sm" + (x.cash.share < 0 ? " neg" : "")}>
                    {share(x.cash.share)}
                  </td>
                  <td class="n hide-sm">
                    {[x.cash.budget_source, x.cash.actual_source]
                      .filter(Boolean)
                      .map((source) => <BudgetReceipt source={source} />)
                      .flatMap((node, index) =>
                        index ? [" · ", node] : [node],
                      )}
                  </td>
                </tr>
              </>
            ))}
        </tbody>
      </table>
    </div>
    <p class="sched-hint" style="margin-block-start:2.5rem">
      Scroll sideways for more columns.
    </p>
    <div class="sched-wrap budget-accounts-trend">
      <table class="sched pin-rows tight">
        <caption>
          Surplus or deficit, and net debt, for the whole government
        </caption>
        <thead>
          <tr>
            <th scope="col">Fiscal year</th>
            <th scope="col" class="n">
              Budget
            </th>
            <th scope="col" class="n">
              Actual
            </th>
            <th scope="col" class="n hide-sm">
              Difference
            </th>
            <th scope="col" class="n">
              Net debt at year end
            </th>
            <th scope="col" class="n hide-sm">
              Per person
            </th>
            <th scope="col" class="n hide-sm">
              Source
            </th>
          </tr>
        </thead>
        <tbody>
          {B.years.map((x) => {
            const b = x.accounts.balance,
              nd = x.accounts.net_debt;
            return (
              <>
                <tr>
                  <th scope="row">
                    <BudgetYearLink x={x} latestYear={B.latest.year} />
                    <BudgetSources
                      pairs={[
                        [
                          b.source || b.budget_source,
                          b.source ? "Accounts source" : "Budget source",
                        ],
                        [
                          nd.source || nd.budget_source,
                          nd.source
                            ? "Net debt source"
                            : "Net debt budget source",
                        ],
                      ]}
                    />
                  </th>
                  <BudgetCell value={b.budget} />
                  <BudgetCell value={b.actual} />
                  {b.actual == null ? (
                    <>
                      <td class="n hide-sm"></td>
                    </>
                  ) : (
                    <BudgetCell
                      value={b.actual - b.budget}
                      extra={" hide-sm"}
                    />
                  )}
                  {nd.actual == null ? (
                    <>
                      <td class="n muted">
                        <BudgetUnit text={words(nd.budget)} />
                        <span class="meta">budgeted</span>
                      </td>
                    </>
                  ) : (
                    <BudgetCell value={nd.actual} />
                  )}
                  <td class="n hide-sm">
                    {x.accounts.net_debt_per_person
                      ? money(x.accounts.net_debt_per_person.value)
                      : ""}
                  </td>
                  <td class="n hide-sm">
                    {[b.source || b.budget_source, nd.source]
                      .filter(Boolean)
                      .map((source) => <BudgetReceipt source={source} />)
                      .flatMap((node, index) =>
                        index ? [" · ", node] : [node],
                      )}
                  </td>
                </tr>
              </>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="small muted">
      A surplus is printed plain and a deficit in parentheses.
      {accord && (
        <>
          {" "}
          The 2019-20 Public Accounts put that year's surplus down "in large
          part" to the Atlantic Accord (2019) (
          <BudgetReceipt source={{ ...accord, page: null }} />
          ).
        </>
      )}
      {restated.length > 0 && (
        <>
          {" "}
          Later accounts restated some of these figures:{" "}
          {restated
            .map((x) => (
              <>
                {x.year}{" "}
                {[
                  x.accounts.balance.restated != null ? (
                    <>
                      {x.accounts.balance.restated < 0 ? "deficit" : "surplus"}{" "}
                      to {words(x.accounts.balance.restated)} (
                      <BudgetReceipt
                        source={x.accounts.balance.restated_source}
                      />
                      )
                    </>
                  ) : null,
                  x.accounts.net_debt.restated != null ? (
                    <>
                      net debt to {words(x.accounts.net_debt.restated)} (
                      <BudgetReceipt
                        source={x.accounts.net_debt.restated_source}
                      />
                      )
                    </>
                  ) : null,
                ]
                  .filter(Boolean)
                  .flatMap((node, index) => (index ? [" and ", node] : [node]))}
              </>
            ))
            .flatMap((node, index) => (index ? ["; ", node] : [node]))}
          . The table shows each year as first published.
        </>
      )}
    </p>
  </div>
</section>
