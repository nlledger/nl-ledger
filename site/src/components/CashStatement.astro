---
import BudgetCashRow from "./StatementRow.astro";
import BudgetCell from "./BudgetCell.astro";
import BudgetReceipt from "./BudgetReceipt.astro";
const { c, need, DOCS, fy } = Astro.props;
---

<p class="sched-hint">Scroll sideways for more columns.</p>
<div class="sched-wrap">
  <table class="sched pin-rows stmt tight">
    <caption>What departments were given, and what they spent</caption>
    <thead>
      <tr>
        <th scope="col">
          <span class="vh">Line</span>
        </th>
        <th scope="col" class="n">
          Budgeted
        </th>
        <th scope="col" class="n">
          Spent
        </th>
        <th scope="col" class="n">
          Over (under)
        </th>
      </tr>
    </thead>
    <tbody>
      <BudgetCashRow
        label={
          <>
            Current account
            <span class="meta">
              salaries, supplies, operating grants, interest
            </span>
          </>
        }
        x={c.current}
      />
      <BudgetCashRow
        label={
          <>
            Capital account
            <span class="meta">
              construction, infrastructure, major equipment, loans
            </span>
          </>
        }
        x={c.capital}
      />
      <tr class="total">
        <th scope="row">Spending by departments</th>
        <BudgetCell value={c.gross.budget} />
        <BudgetCell value={c.gross.actual} />
        <BudgetCell value={c.difference} />
      </tr>
      <BudgetCashRow
        label={
          <>
            Revenue tied to that spending
            <span class="meta">
              federal cost-sharing, fees; "related revenue"
            </span>
          </>
        }
        x={c.related}
      />
      <BudgetCashRow
        label={
          <>
            Other provincial and federal revenue
            <span class="meta">taxes, royalties, transfers</span>
          </>
        }
        x={c.revenue}
      />
      <BudgetCashRow
        label={
          <>
            Cash {need.actual < 0 ? "left over" : "requirement"}
            <span class="meta">spending the revenue did not cover</span>
          </>
        }
        x={need}
      />
    </tbody>
  </table>
</div>
<p class="small muted">
  Modified cash basis, government departments only: the basis the House of
  Assembly votes on. Budgeted: {DOCS[c.budget_source.doc]} {fy},{" "}
  <BudgetReceipt source={c.budget_source} />. Spent: {DOCS.report} {fy},{" "}
  <BudgetReceipt source={c.actual_source} />.
</p>
