---
import Schedule from "./Schedule.astro";
import PageHead from "./PageHead.astro";
import { moneyWords, money } from "../../lib/format.mjs";
import Bar from "./Bar.astro";
const { fy, R, BILLION, pins } = Astro.props;
---

<PageHead
  crumbs={[
    ["/", "Home"],
    [null, "$1 billion comparisons"],
  ]}
  title={"How big is $1 billion?"}
  lede={
    "Each amount below is compared independently with CAD 1 billion. These examples cover different years and kinds of money and can overlap; they are not parts of a provincial budget and must not be added."
  }
/>
<section class="section">
  <div class="wrap">
    <p class="lede">
      In {fy}, provincial department actuals were {moneyWords(R.total)},{" "}
      {(R.total / BILLION).toFixed(1)} times this reference amount. Federal
      record values are separate commitments, not provincial spending.
    </p>
    <>
      <Schedule label="Independent comparisons against CAD 1 billion">
        <thead>
          <tr>
            <th scope="col">Example, amount kind and period</th>
            <th scope="col" style={"inline-size:" + "30%"}>
              Against CAD 1 billion
            </th>
            <th scope="col" class="n">
              Reported value
            </th>
          </tr>
        </thead>
        <tbody>
          {pins.map((p) => (
            <tr>
              <th scope="row">
                <>
                  <a href={p.href}>{p.label}</a>
                  <span class="meta">{p.detail}</span>
                </>
              </th>
              <td>
                <span class="vh">
                  {((p.amount / BILLION) * 100).toFixed(4)}% of CAD 1 billion
                </span>
                <Bar value={p.amount} max={BILLION} />
              </td>
              <td class="n">
                {money(p.amount, {
                  cents: true,
                })}
              </td>
            </tr>
          ))}
        </tbody>
      </Schedule>
    </>
    <p class="small">
      Each bar starts at zero and uses the same CAD 1 billion scale. No
      remainder or combined example total is calculated. The median wage is a
      reference annual wage, not local wages created by a contract.
    </p>
  </div>
</section>
