---
import Caveat from "./Caveat.astro";
import PageHead from "./PageHead.astro";
import { icon } from "../../lib/icons.mjs";
import FederalSummary from "./FederalSummary.astro";
import PatternResults from "./PatternResults.astro";
const { f, seo, cat, D } = Astro.props;
---

<PageHead
  crumbs={[
    ["/", "Home"],
    ["/flags/", "Patterns"],
    [null, f.title],
  ]}
  title={f.title}
  lede={f.short}
/>
<section class="section">
  <div class="wrap">
    <div class="grid-2" style="margin-block-end:2.5rem">
      <div>
        <p>{f.why}</p>
        {seo?.note ? (
          <>
            <p>{seo.note}</p>
          </>
        ) : (
          ""
        )}
        <p>
          <a href={"/method/" + f.id + "/"}>
            How this is worked out, and what it cannot tell you{" "}
            <Fragment set:html={icon("arrow")} />
          </a>
        </p>
      </div>
      <div>
        <Caveat text={cat.caveat} />
      </div>
    </div>
    <PatternResults f={f} D={D} />
    {f.data.some((d) =>
      ["fed_contract", "fed_grant", "canadabuys", "pa_pss", "pa_tp"].includes(
        d,
      ),
    ) ? (
      <FederalSummary
        D={D}
        where={"id IN (SELECT item_id FROM flags WHERE flag=?)"}
        args={[f.id]}
      />
    ) : (
      ""
    )}
  </div>
</section>
