---
import Schedule from "./Schedule.astro";
import { nameOrder } from "../../lib/page-format.mjs";
import PageHead from "./PageHead.astro";
import Bar from "./Bar.astro";
import { money, num, moneyWords } from "../../lib/format.mjs";
const { latestFull, ranked, D, perYear, rmax, mins, mhas } = Astro.props;
---

<PageHead
  flagged={true}
  crumbs={[
    ["/", "Home"],
    [null, "Members"],
  ]}
  title={"MHA expenses and minister expense claims"}
  lede={
    "What each Member of the House of Assembly (MHA) claimed against their office, travel and constituency allowances, and what each minister claimed in expenses, line by line as the House and Executive Council publish it."
  }
/>
<section class="section">
  <div class="wrap grid-2">
    <div>
      <div class="section-head">
        <h2>MHA spending, {latestFull}</h2>
        <p>
          Office, travel and constituency allowances. The House publishes a
          limit for most categories;{" "}
          <a href="/flags/over-allowance/">no member went past one</a>. Members
          who served part of the year, or who are ministers or party leaders
          with other budgets, spend less from these allowances, so the list is
          not a ranking of thrift.
        </p>
      </div>
      <>
        <Schedule compact>
          <thead>
            <tr>
              <th scope="col">Member</th>
              <th scope="col" style={"inline-size:" + "36%"}>
                {""}
              </th>
              <th scope="col" class="n">
                Spent
              </th>
            </tr>
          </thead>
          <tbody>
            {ranked.map((m) => (
              <tr>
                <th scope="row">
                  <>
                    <a href={"/mha/" + D.slug(m.person) + "/"}>
                      {nameOrder(m.person)}
                    </a>
                    <span class="meta">{m.district || ""}</span>
                  </>
                </th>
                <td>
                  <Bar value={perYear.get(m.person)[latestFull]} max={rmax} />
                </td>
                <td class="n">{money(perYear.get(m.person)[latestFull])}</td>
              </tr>
            ))}
          </tbody>
        </Schedule>
      </>
    </div>
    <div>
      <div class="section-head">
        <h2>Ministers' claims</h2>
        <p>
          Travel, meals, accommodation and car allowance paid to cabinet
          ministers, December 2020 to May 2026.
        </p>
      </div>
      <>
        <Schedule compact>
          <thead>
            <tr>
              <th scope="col">Minister</th>
              <th scope="col" class="n">
                Claims
              </th>
              <th scope="col" class="n">
                Paid
              </th>
            </tr>
          </thead>
          <tbody>
            {mins.map((m) => (
              <tr>
                <th scope="row">
                  <>
                    <a href={"/ministers/" + D.slug(m.person) + "/"}>
                      {m.person}
                    </a>
                  </>
                </th>
                <td class="n">{num(m.n)}</td>
                <td class="n">{money(m.amount)}</td>
              </tr>
            ))}
          </tbody>
        </Schedule>
      </>
      <h3 style="margin-block:2rem .8rem">Every MHA since 2020-21</h3>
      <ul class="twocol">
        {mhas.map((m) => (
          <>
            <li>
              <a href={"/mha/" + D.slug(m.person) + "/"}>
                {nameOrder(m.person)}
              </a>
              <span>{moneyWords(m.amount)}</span>
            </li>
          </>
        ))}
      </ul>
    </div>
  </div>
</section>
