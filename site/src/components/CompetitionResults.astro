---
import Schedule from "./Schedule.astro";
import BodyAnchor from "./BodyAnchor.astro";
import { num, moneyWords, pct } from "../../lib/format.mjs";
import Bar from "./Bar.astro";
const { prov, D, fed } = Astro.props;
---

<h2 style="margin-block-end:1rem">Provincial public bodies</h2>
<>
  <Schedule label="Provincial awards without competition">
    <thead>
      <tr>
        <th scope="col">Public body</th>
        <th data-graphic-header scope="col" style={"inline-size:" + "28%"}>
          <span class="vh">Relative amount</span>
        </th>
        <th scope="col" class="n">
          Without competition
        </th>
        <th scope="col" class="n">
          Of all reported
        </th>
        <th scope="col" class="n">
          Share
        </th>
      </tr>
    </thead>
    <tbody>
      {prov.slice(0, 40).map((s) => (
        <tr>
          <th scope="row">
            <>
              <BodyAnchor D={D} name={s.subject} />
              <span class="meta">
                {num(s.x.exception_awards)} of {num(s.x.awards)} awards
              </span>
            </>
          </th>
          <td>
            <Bar value={s.value} max={1} />
          </td>
          <td class="n">{moneyWords(s.x.exception_amount)}</td>
          <td class="n">{moneyWords(s.x.amount)}</td>
          <td class="n">{pct(s.value)}</td>
        </tr>
      ))}
    </tbody>
  </Schedule>
</>
<h2 style="margin-block:2.5rem 1rem">
  Federal departments, contracts selected by supplier NL postal code
</h2>
<p class="small">
  Shares are of selected reported contract values, all years, not department
  spending in NL or all department contracts. An address does not locate the
  work or benefit.
</p>
<>
  <Schedule label="Federal contracts without competition">
    <thead>
      <tr>
        <th scope="col">Department</th>
        <th scope="col" class="n">
          Non-competitive
        </th>
        <th scope="col" class="n">
          Of all
        </th>
        <th scope="col" class="n">
          Share
        </th>
      </tr>
    </thead>
    <tbody>
      {fed.map((s) => (
        <tr>
          <th scope="row">
            <BodyAnchor D={D} name={s.subject} />
          </th>
          <td class="n">{moneyWords(s.x.exception_amount)}</td>
          <td class="n">{moneyWords(s.x.amount)}</td>
          <td class="n">{pct(s.value)}</td>
        </tr>
      ))}
    </tbody>
  </Schedule>
</>
