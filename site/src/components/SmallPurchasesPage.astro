---
import Schedule from "./Schedule.astro";
import { ITEM_COLS } from "../common.mjs";
import { words } from "../../lib/budget-format.mjs";
import Caveat from "./Caveat.astro";
import PageHead from "./PageHead.astro";
import {
  num,
  money,
  pct,
  date as fmtDate,
  moneyWords,
} from "../../lib/format.mjs";
import Citation from "./Citation.astro";
import Bar from "./Bar.astro";
import ItemRow from "./ItemRow.astro";
const {
  p,
  citeP,
  median,
  under1k,
  months,
  mmax,
  vendors,
  D,
  sj,
  sjTop,
  itemRow,
} = Astro.props;
---

<PageHead
  crumbs={[
    ["/", "Home"],
    [null, "Small purchases"],
  ]}
  title={"The small purchases"}
  lede={
    "Most public money goes out in amounts too small to make a contract report. Two municipalities publish every payment; the province does not."
  }
/>
<section class="section">
  <div class="wrap">
    <div class="figs">
      <div>
        <span class="big">{num(p.n)}</span>
        <span class="what">
          payments by the Town of Paradise, {fmtDate(p.d0)} to {fmtDate(p.d1)}
          <Citation citation={citeP} />
        </span>
      </div>
      <div>
        <span class="big">{money(median)}</span>
        <span class="what">the middle payment</span>
      </div>
      <div>
        <span class="big">{pct(under1k / p.n)}</span>
        <span class="what">of payments were under $1,000</span>
      </div>
    </div>
    <Caveat
      text={
        "The provincial government publishes no line-by-line payments: the Public Accounts list departments and programs, not who was paid. Federal departments publish totals only for purchases under $10,000. An access-to-information request is the only route to the province's small purchases."
      }
    />
  </div>
</section>
<section class="section">
  <div class="wrap grid-2">
    <div>
      <h2 style="margin-block-end:1rem">Paradise, month by month</h2>
      <>
        <Schedule label="Paradise payments by month" compact>
          <thead>
            <tr>
              <th scope="col">Month</th>
              <th data-graphic-header scope="col" style={"inline-size:" + "55%"}>
                <span class="vh">Relative amount</span>
              </th>
              <th scope="col" class="n">
                Paid
              </th>
            </tr>
          </thead>
          <tbody>
            {months.map((m) => (
              <tr>
                <th scope="row">{fmtDate(m.m)}</th>
                <td>
                  <Bar value={m.amount} max={mmax} />
                </td>
                <td class="n">{moneyWords(m.amount)}</td>
              </tr>
            ))}
          </tbody>
        </Schedule>
      </>
    </div>
    <div>
      <h2 style="margin-block-end:1rem">Paradise's biggest vendors</h2>
      <>
        <Schedule label="Small purchases by supplier" compact>
          <thead>
            <tr>
              <th scope="col">Vendor</th>
              <th scope="col" class="n">
                Payments
              </th>
              <th scope="col" class="n">
                Paid
              </th>
            </tr>
          </thead>
          <tbody>
            {vendors.map((v) => (
              <tr>
                <th scope="row">
                  <>
                    <a href={"/supplier/" + D.keyHash(v.supplier_key) + "/"}>
                      {v.supplier}
                    </a>
                  </>
                </th>
                <td class="n">{num(v.n)}</td>
                <td class="n">{moneyWords(v.amount)}</td>
              </tr>
            ))}
          </tbody>
        </Schedule>
      </>
      <h3 style="margin-block:2rem .8rem">What gets bought most often</h3>
      <>
        <Schedule label="Most frequent purchases" compact>
          <thead>
            <tr>
              <th scope="col">Description as printed</th>
              <th scope="col" class="n">
                Times
              </th>
              <th scope="col" class="n">
                Paid
              </th>
            </tr>
          </thead>
          <tbody>
            {words.map((w) => (
              <tr>
                <th scope="row">
                  <>
                    <a
                      href={
                        "/search/?ds=paradise&q=" +
                        encodeURIComponent(w.d.slice(0, 60))
                      }
                    >
                      {w.d}
                    </a>
                  </>
                </th>
                <td class="n">{num(w.n)}</td>
                <td class="n">{moneyWords(w.amount)}</td>
              </tr>
            ))}
          </tbody>
        </Schedule>
      </>
    </div>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>St. John's, a sample</h2>
      <p>
        The City of St. John's publishes every weekly payment voucher, but as
        scanned images. {num(sj.n)} lines from the first 12 pages of the 2026
        file were read by machine as a sample. {num(sj.w)} of them are payments
        to private individuals whose names the City blacks out; those show the
        description only.
      </p>
    </div>
    <>
      <Schedule label="Small purchase records">
        <thead>
          <tr>
            {ITEM_COLS.map((c) => (
              <th
                scope="col"
                class={c.num ? "n" : undefined}
                style={c.w ? `inline-size:${c.w}` : undefined}
              >
                {c.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {sjTop.map((a) => (
            <ItemRow
              D={D}
              it={a}
              {...{
                showBuyer: false,
              }}
            />
          ))}
        </tbody>
      </Schedule>
    </>
    <p>
      <a href="/search/?ds=stjohns">All sampled St. John's lines</a>
    </p>
  </div>
</section>
