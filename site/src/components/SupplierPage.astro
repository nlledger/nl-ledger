---
import Schedule from "./Schedule.astro";
import { num, moneyWords, money, DATASET_LABEL } from "../../lib/format.mjs";
import SupplierNames from "./SupplierNames.astro";
import Standing from "./Standing.astro";
import {
  SCOPE_LABEL,
  REVIEW_LABEL,
  periodText,
  nativeAmount,
  FEDERAL_RULE,
  OVERLAP_RULE,
} from "../../lib/federal.mjs";
import BodyLink from "./BodyLink.astro";
import Bar from "./Bar.astro";
import FlagItem from "./FlagItem.astro";
import SearchResult from "./SearchResult.astro";
import { icon } from "../../lib/icons.mjs";
import SpotError from "./SpotError.astro";
const { s, hash, dsRows, links, years, ymax, flagRows, flags } = Astro.props;
---

<header class="pagehead">
  <div class="wrap">
    <p class="crumbs">
      <a href="/">Home</a> / <a href="/search/">Search</a> / Supplier
    </p>
    <h1>{s.name}</h1>
    <p class="lede">
      {num(s.n)} {s.n === 1 ? "record" : "records"} across provincial and
      federal sources: {moneyWords(s.total)} in included CAD record values
      across all years
      {s.overlap
        ? `; ${moneyWords(s.overlap)} in federal payment and award notice values excluded from this total because these sources can overlap contracts and grants`
        : ""}
      {s.city ? `. Listed in ${s.city}` : ""}.
      {s.names
        ? ` Also printed as: ${s.names
            .filter((n) => n !== s.name)

            .join("; ")}.`
        : ""}
    </p>
    {s.businessNumbers?.length > 1 ? (
      <>
        <div class="combined small">
          <p>
            The records carry more than one business number, listed as
            published:{" "}
            {s.businessNumbers.flatMap((node, index) =>
              index ? ["; ", node] : [node],
            )}
            . This page groups the organisation the publisher named; it does not
            verify who holds each number.
          </p>
        </div>
      </>
    ) : (
      ""
    )}
    {s.related?.length ? (
      <>
        <div class="combined small">
          <p>
            <strong>
              {s.identityUnresolved
                ? "Identity unresolved."
                : "Different organisations identified by named source records."}
            </strong>{" "}
            Other pieces have the same or a closely matched published name. This
            page's total covers only its own records; read the other pieces
            before treating it as the organisation's whole record.
          </p>
          <ul>
            {s.related.map((r) => (
              <>
                <li>
                  <a href={"/supplier/" + r.h + "/"}>{r.name}</a>: {num(r.n)}{" "}
                  {r.n === 1 ? "record" : "records"};{" "}
                  {money(r.total, {
                    cents: true,
                  })}{" "}
                  in included record values
                  {r.overlap
                    ? `; ${money(r.overlap, {
                        cents: true,
                      })} excluded because sources can overlap`
                    : ""}
                  .
                </li>
              </>
            ))}
          </ul>
        </div>
      </>
    ) : (
      ""
    )}
    {s.anchors?.length ? (
      <>
        <p class="small">
          Named source evidence:{" "}
          {s.anchors
            .map(([name, url]) => (
              <>
                <a href={url}>{name}</a>
              </>
            ))
            .flatMap((node, index) => (index ? ["; ", node] : [node]))}
          .
        </p>
      </>
    ) : (
      ""
    )}
    {s.combined ? <SupplierNames s={s} hash={hash} /> : ""}
    <Standing />
  </div>
</header>
<section class="section">
  <div class="wrap">
    <div class="figs">
      <div>
        <span class="big">{moneyWords(s.total)}</span>
        <span class="what">
          included CAD record values, all years; not total money paid
          (agreements can span several years)
        </span>
      </div>
    </div>
    <p class="small muted">
      Awards and contract values are commitments; payments are amounts reported
      as paid. Sources can overlap, so even included record values are not a
      deduplicated spending total.{" "}
      <a href="/method/suppliers/">What this total includes</a>.
    </p>
    <p class="small">
      {FEDERAL_RULE} {OVERLAP_RULE}
    </p>
    {s.breakdown?.length ? (
      <>
        <Schedule>
          <caption>
            Reported values by source, location evidence and currency
          </caption>
          <thead>
            <tr>
              <th scope="col">Source and evidence</th>
              <th scope="col" class="n">
                Records
              </th>
              <th scope="col" class="n">
                Native value
              </th>
            </tr>
          </thead>
          <tbody>
            {s.breakdown.map((g) => (
              <tr>
                <th scope="row">
                  <>
                    {DATASET_LABEL[g.source] || g.source}
                    <>
                      <span class="meta">
                        {g.amount_kind};{" "}
                        {SCOPE_LABEL[g.scope_status] || "Provincial records"};{" "}
                        {g.scope_review_state
                          ? REVIEW_LABEL[g.scope_review_state] + "; "
                          : ""}
                        {g.counting_basis};{" "}
                        {g.included_in_summary
                          ? "included"
                          : g.exclusion_reason}
                        . Periods: {periodText(g.periods)}. {g.missing_amounts}{" "}
                        amounts not stated; {g.zero_amounts} published zeros.
                      </span>
                    </>
                  </>
                </th>
                <td class="n">{num(g.records)}</td>
                <td class="n">
                  {nativeAmount(
                    g.records === g.missing_amounts ? null : g.value,
                    g.currency,
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </Schedule>
      </>
    ) : (
      ""
    )}
    <div class="grid-2 supplier-breakdown">
      <div class="supplier-schedules">
        <>
          <Schedule compact>
            <caption>By source, supported CAD values only</caption>
            <thead>
              <tr>
                <th scope="col">Source</th>
                <th scope="col" class="n">
                  Records
                </th>
                <th scope="col" class="n">
                  Value
                </th>
              </tr>
            </thead>
            <tbody>
              {dsRows.map(([d, [n, a]]) => (
                <tr>
                  <th scope="row">
                    <>
                      {DATASET_LABEL[d] || d}
                      {["pa_pss", "pa_tp", "canadabuys"].includes(d) ? (
                        <>
                          <span class="meta">
                            excluded from the total; can overlap contracts and
                            grants
                          </span>
                        </>
                      ) : (
                        ""
                      )}
                    </>
                  </th>
                  <td class="n">{num(n)}</td>
                  <td class="n">{moneyWords(a)}</td>
                </tr>
              ))}
            </tbody>
          </Schedule>
        </>
        {s.buyers?.length ? (
          <>
            <>
              <p class="small muted">
                Included values make up the headline; excluded values are shown
                separately and never added to it. Neither column means this body
                paid these amounts.
              </p>
            </>
            <>
              <Schedule compact>
                <caption>Public bodies named in these records</caption>
                <thead>
                  <tr>
                    <th scope="col">Public body</th>
                    <th scope="col" class="n">
                      Records
                    </th>
                    <th scope="col" class="n">
                      Included value
                    </th>
                    <th scope="col" class="n">
                      Excluded value
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {s.buyers.map((b) => (
                    <tr>
                      <th scope="row">
                        <BodyLink name={b.name} links={links} />
                      </th>
                      <td class="n">{num(b.n)}</td>
                      <td class="n">{moneyWords(b.included)}</td>
                      <td class="n">{moneyWords(b.excluded)}</td>
                    </tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr class="total">
                    <th scope="row">All public bodies</th>
                    <td class="n">{num(s.n)}</td>
                    <td class="n">{moneyWords(s.total)}</td>
                    <td class="n">{moneyWords(s.overlap)}</td>
                  </tr>
                </tfoot>
              </Schedule>
            </>
          </>
        ) : (
          ""
        )}
      </div>
      <div>
        {years.length > 1 ? (
          <>
            <Schedule compact>
              <caption>Included CAD values by original record year</caption>
              <thead>
                <tr>
                  <th scope="col">Year</th>
                  <th data-graphic-header scope="col" style={"inline-size:" + "55%"}>
                    <span class="vh">Relative amount</span>
                  </th>
                  <th scope="col" class="n">
                    Value
                  </th>
                </tr>
              </thead>
              <tbody>
                {years.map(([y, v]) => (
                  <tr>
                    <th scope="row">{y}</th>
                    <td>
                      <Bar value={v} max={ymax} />
                    </td>
                    <td class="n">{moneyWords(v)}</td>
                  </tr>
                ))}
              </tbody>
            </Schedule>
          </>
        ) : (
          ""
        )}
        {flagRows.length ? (
          <>
            <h2 class="minor-heading" style="margin-block:1.5rem .6rem">
              Patterns
            </h2>
            <ul class="flaglist">
              {flagRows.map((x) => (
                <FlagItem
                  f={x.f}
                  count={`${num(x.n)} ${x.n === 1 ? "record" : "records"}`}
                  method={true}
                />
              ))}
            </ul>
          </>
        ) : (
          ""
        )}
      </div>
    </div>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <h2 style="margin-block-end:1rem">Largest records</h2>
    <ol class="results">
      {s.top.map((it) => (
        <SearchResult
          it={{
            ...it,
            s: undefined,
            k: undefined,
            fy: undefined,
          }}
          flags={flags}
          links={links}
        />
      ))}
    </ol>
    {s.n > s.top.length ? (
      <>
        <p style="margin-block-start:1.5rem">
          <a href={"/search/?s=" + hash}>
            All {num(s.n)} records <Fragment set:html={icon("arrow")} />
          </a>
        </p>
      </>
    ) : (
      ""
    )}
  </div>
</section>
<div class="wrap">
  <SpotError />
</div>
