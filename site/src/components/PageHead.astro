---
import Standing from "./Standing.astro";
const { crumbs = [], title, lede, extra = "", flagged = false } = Astro.props;
---

<header class="pagehead">
  <div class="wrap">
    {crumbs.length > 0 && (
      <p class="crumbs">
        {crumbs.map(([href, label], index) => (
          <>
            {index > 0 && " / "}
            {href ? <a href={href}>{label}</a> : label}
          </>
        ))}
      </p>
    )}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    {flagged && <Standing />}
    {extra}
  </div>
</header>
