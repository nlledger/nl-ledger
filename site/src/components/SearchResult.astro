---
import { amountText } from "../../lib/page-format.mjs";
import RecordParty from "./RecordParty.astro";
import QueryMark from "./QueryMark.astro";
import {
  DATASET_LABEL,
  BUYER_LABEL,
  date as fmtDate,
  AMOUNT_LABEL,
} from "../../lib/format.mjs";
import BodyLink from "./BodyLink.astro";
import ReceiptLink from "./ReceiptLink.astro";
import {
  isFederal,
  amountBasis,
  federalStatement,
  moneyLimit,
} from "../../lib/federal.mjs";
const { it, flags, links } = Astro.props;
const party =
  it.s && it.ds !== "sunshine"
    ? ["fed_grant", "pa_tp"].includes(it.ds)
      ? "Recipient"
      : it.ds === "mha"
        ? "Paid to"
        : "Supplier"
    : "";
---

<li class="result">
  <span class="who">
    {party ? (
      <>
        <span class="party-label">{party}: </span>
      </>
    ) : (
      ""
    )}
    <RecordParty it={it} />
  </span>
  <span class="amt">
    {amountText(it)}
    <QueryMark flags={it.f} catalog={flags} />
    <span class="amount-type">
      {isFederal(it)
        ? amountBasis(it)
        : AMOUNT_LABEL[it.ds] || "Published value"}
    </span>
  </span>
  {isFederal(it) ? (
    <>
      <p class="what">
        {federalStatement(it)} {moneyLimit(it)}
      </p>
    </>
  ) : (
    ""
  )}
  {it.d && (it.s || it.p) ? (
    <>
      <p class="what">{it.d}</p>
    </>
  ) : (
    ""
  )}
  <div class="meta">
    {[
      <>
        <a
          class="tag"
          href={"/sources/#" + it.ds}
          title="Where these records come from"
        >
          {DATASET_LABEL[it.ds] || it.ds}
        </a>
      </>,
      it.b ? (
        <>
          <span>
            {BUYER_LABEL[it.ds] || "Public body"}:{" "}
            <BodyLink
              name={it.b}
              links={links}
              sunshine={it.ds === "sunshine"}
            />
          </span>
        </>
      ) : (
        ""
      ),
      it.p && it.s ? (
        <>
          <span>{it.p}</span>
        </>
      ) : (
        ""
      ),
      it.t || it.fy ? (
        <>
          <span>{fmtDate(it.t) || it.fy}</span>
        </>
      ) : (
        ""
      ),
      it.m ? (
        <>
          <span>{it.m}</span>
        </>
      ) : (
        ""
      ),
    ].filter(Boolean)}
  </div>
  <div class="result-actions">
    <a href={"/item/" + it.i + "/"}>Record</a>
    <ReceiptLink url={it.u} page={it.g} locator={it.l} />
  </div>
</li>
