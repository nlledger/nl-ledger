---
const { num, s, hash } = Astro.props;
---

<div class="combined small">
  <p>
    This page combines <Fragment set:html={num(s.combined.length)} /> printed
    names, joined on the evidence described in the method:
  </p>
  <ul>
    {s.combined.map((c) => (
      <>
        <li>
          <a href={"/search/?s=" + hash + "&amp;n=" + c.h}>{c.t}</a>{" "}
          <span>
            <Fragment set:html={num(c.n)} />{" "}
            <Fragment set:html={c.n === 1 ? "record" : "records"} />
          </span>
        </li>
      </>
    ))}
  </ul>
  <p>
    <a href="/method/suppliers/">How names are matched</a> ·{" "}
    <a href="https://github.com/nlledger/nl-ledger/issues/new?template=challenge-method.yml">
      Question this match
    </a>
  </p>
</div>
