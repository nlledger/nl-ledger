---
import { icon } from "../../lib/icons.mjs";
const { f, count = "", method = false, level = 3 } = Astro.props;
const Heading = `h${level}`;
---

<li class="flagitem">
  <span class="q" aria-hidden="true">
    <Fragment set:html={icon("query")} />
  </span>
  <Heading class="minor-heading">
    <a href={`/flags/${f.id}/`}>
      {f.title}
      <Fragment set:html={icon("arrow")} />
    </a>
  </Heading>
  <span class="count">{count}</span>
  <p>
    {f.short}
    {method && (
      <>
        {" "}
        <a class="method" href={`/method/${f.id}/`}>
          Method<span class="vh"> for {f.title}</span>
        </a>
      </>
    )}
  </p>
</li>
