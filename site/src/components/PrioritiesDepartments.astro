---
import { moneyWords, money, perPerson, workTime } from "../../lib/format.mjs";
import Citation from "./Citation.astro";
const { sum, latest, cite, S } = Astro.props;
---

<div class="figs">
  <div>
    <span class="big">{moneyWords(sum.gross)}</span>
    <span class="what">
      spent by the province in {latest}
      <Citation citation={cite} />
    </span>
  </div>
  <div>
    <span class="big">{money(perPerson(sum.gross, S))}</span>
    <span class="what">
      of provincial spending for every person in the province
    </span>
  </div>
  <div>
    <span class="big">{workTime(sum.gross, S)}</span>
    <span class="what">
      of work at the median full-time wage to earn what the province spent
    </span>
  </div>
</div>
